# Family Safety — environment variables template
# Copy to .env for local development. NEVER commit real .env.

# Environment: development | staging | production
FS_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR
FS_LOG_LEVEL=INFO

# JWT secret — MUST be >= 32 chars in production
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
FS_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Auth token lifetimes
FS_ACCESS_MIN=15
FS_REFRESH_DAYS=30

# Database
# - empty      -> SQLite at FS_DB_PATH
# - postgres:// -> PostgreSQL via psycopg2
DATABASE_URL=
FS_DB_PATH=./data/familysafety.db

# Contracts directory
FS_CONTRACTS_V1_DIR=./shared/contracts/v1
FS_CONTRACTS_V2_DIR=./shared/contracts/v2
