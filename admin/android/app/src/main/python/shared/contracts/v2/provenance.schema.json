{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://familysafety.local/contracts/v2/provenance.schema.json",
  "title": "Family Safety Provenance Contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_record_ids",
    "algorithm_id",
    "algorithm_version",
    "calculated_at",
    "confidence",
    "evidence"
  ],
  "properties": {
    "source_record_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 4 }
    },
    "algorithm_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,63}$"
    },
    "algorithm_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "calculated_at": {
      "type": "string",
      "format": "date-time"
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 3, "maxLength": 512 }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["none", "low", "medium", "high"]
        },
        "notes": { "type": ["string", "null"], "maxLength": 1024 }
      }
    },
    "input_hash": {
      "type": ["string", "null"],
      "minLength": 32
    }
  }
}
